<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="10dp" android:background="@drawable/tune_widget_bg">
    <ImageView android:id="@+id/w_logo" android:layout_width="44dp" android:layout_height="44dp"
        android:src="@mipmap/ic_launcher" android:contentDescription="Tune Tune" />
    <TextView android:id="@+id/w_resume" style="@style/TuneWidgetBtn" android:text="▶  Resume" />
    <TextView android:id="@+id/w_liked" style="@style/TuneWidgetBtn" android:text="♥  Favorites" />
    <TextView android:id="@+id/w_offline" style="@style/TuneWidgetBtn" android:text="⇩  Offline" />
    <TextView android:id="@+id/w_party" style="@style/TuneWidgetBtn" android:text="✦  Party" />
</LinearLayout>
