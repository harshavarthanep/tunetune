{
  "name": "tunetune",
  "productName": "Tune Tune",
  "version": "3.1.0",
  "description": "Free music player: YouTube Music catalog, live radio, lyrics, equalizer, offline downloads.",
  "author": "H24 Creationz",
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "web": "npx serve .",
    "android:prepare": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www');for(const f of ['index.html','styles.css','app.js','manifest.webmanifest','sw.js'])fs.copyFileSync(f,'www/'+f);fs.cpSync('icons','www/icons',{recursive:true})\"",
    "android:setup": "node scripts/android-setup.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@jofr/capacitor-media-session": "4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.h24creationz.tunetune",
    "productName": "Tune Tune",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "manifest.webmanifest",
      "sw.js",
      "icons/**",
      "desktop/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "icons/icon-512.png",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/icon-512.png",
      "category": "Audio"
    }
  }
}